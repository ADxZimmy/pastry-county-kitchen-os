DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# Dedicated secret used to sign session tokens. REQUIRED in production (min 16 chars).
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Phase 011 migration window. Sessions live in an HttpOnly cookie; the older
# localStorage bearer token stays accepted until every client and smoke has
# moved. Set to "off" to reject bearer credentials (the Phase 011 end state).
AUTH_BEARER_COMPAT=
# Public origin used to validate mutating requests and to build password-reset
# links. Optional: the request's own forwarded host is trusted by default.
APP_ORIGIN=
PORT=5174
VITE_API_BASE_URL=
LIVE_BASE_URL=https://pastry-county-kitchen-os.vercel.app
LIVE_TEST_EMAIL=
LIVE_TEST_PASSWORD=
MILESTONE7_SMOKE_MUTATE=0
LIVE_AUDIT_SMOKE_BASE_URL=
LIVE_AUDIT_DATABASE_URL=
REGRESSION_AUDIT_SMOKE_BASE_URL=
REGRESSION_AUDIT_SMOKE_MUTATE=0
