DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# Dedicated secret used to sign session tokens. REQUIRED in production (min 16 chars).
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Phase 011 migration window. Sessions live in an HttpOnly cookie; the older
# localStorage bearer token stays accepted until every client and smoke has
# moved. Set to "off" to reject bearer credentials (the Phase 011 end state).
AUTH_BEARER_COMPAT=
# Public origin used to validate mutating requests and to build password-reset
# links. Optional: the request's own forwarded host is trusted by default.
APP_ORIGIN=
# Phase 014 assistant. Unset means the deterministic Kitchen Helper answers, which
# is a supported state, not a broken one. Provider-neutral: anthropic | openai
# (ASSISTANT_BASE_URL also accepts any OpenAI-compatible endpoint).
#
# The vendors' own variable names are accepted too, so a key already present
# under its conventional name does not have to be duplicated:
#   ANTHROPIC_API_KEY    -> sent as x-api-key       (a standard sk-ant-... key)
#   ANTHROPIC_AUTH_TOKEN -> sent as Authorization: Bearer (the oauth beta header
#                           is added ONLY for api.anthropic.com, never a router)
#   OPENAI_API_KEY       -> sent as Authorization: Bearer
#   ANTHROPIC_MODEL / ANTHROPIC_BASE_URL are honoured when anthropic is selected.
# The two Anthropic credentials are NOT interchangeable: an API key sent as a
# bearer token, or an OAuth token sent as x-api-key, is a guaranteed 401.
# /api/health reports which variable supplied each value, never the value itself.
#
# An Anthropic-compatible ROUTER (e.g. agentrouter.org) is an OpenAI-compatible
# gateway: set ASSISTANT_PROVIDER=openai, ASSISTANT_BASE_URL=<host>/v1, and the
# gateway's own key. A base URL that already ends in /v1 is fine -- it is not
# doubled. Prefer the neutral ASSISTANT_* names: ANTHROPIC_BASE_URL/ANTHROPIC_MODEL
# are also read by other local tools and can silently shadow your setting.
ASSISTANT_PROVIDER=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_BASE_URL=
# Some gateways reject an unidentified client ("unauthorized client detected").
# This is the User-Agent the adapter sends; override only if a gateway demands a
# specific value. Default: pastry-county-kitchen-os/1.0
ASSISTANT_USER_AGENT=
# Hard server-side monthly ceiling in USD. Default 10, clamped to 1000 so a typo
# cannot authorise a runaway bill. Reaching it falls back to Kitchen Helper.
ASSISTANT_MONTHLY_BUDGET_USD=
PORT=5174
VITE_API_BASE_URL=
LIVE_BASE_URL=https://pastry-county-kitchen-os.vercel.app
SIGNUP_INVITE_CODE=
LIVE_TEST_EMAIL=
LIVE_TEST_PASSWORD=
MILESTONE7_SMOKE_MUTATE=0
LIVE_AUDIT_SMOKE_BASE_URL=
LIVE_AUDIT_DATABASE_URL=
REGRESSION_AUDIT_SMOKE_BASE_URL=
REGRESSION_AUDIT_SMOKE_MUTATE=0
